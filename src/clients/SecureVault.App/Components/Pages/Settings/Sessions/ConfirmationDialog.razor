<MudDialog>
    <DialogContent>
        <MudText>@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public string ContentText { get; set; } = "Bu işlemi yapmak istediğinizden emin misiniz?";

    [Parameter]
    public string ButtonText { get; set; } = "Onayla";

    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    void Submit(MouseEventArgs e) => MudDialog.Close(DialogResult.Ok(true));

    void Cancel(MouseEventArgs e) => MudDialog.Cancel();
}