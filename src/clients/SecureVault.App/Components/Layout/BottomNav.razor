@using SecureVault.App.Constants

<MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
    <MudAppBar Class="px-4" Bottom Fixed Elevation="1">
        <MudStack Class="mud-width-full" Row Justify="Justify.SpaceBetween">
            <MudStack Spacing="0">
                <MudIconButton Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Inherit" Href="@RouteConstants.TwoFactor" />
                <MudText Typo="Typo.subtitle2">2FA</MudText>
            </MudStack>
            <MudStack Spacing="0">
                <MudIconButton Icon="@Icons.Material.Filled.Password" Size="Size.Small" Color="Color.Inherit" Href="@RouteConstants.Password" />
                <MudText Typo="Typo.subtitle2">Şifreler</MudText>
            </MudStack>
            <MudStack Spacing="0">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Inherit" Href="@RouteConstants.Settings"/>
                <MudText Typo="Typo.subtitle2">Ayarlar</MudText>
            </MudStack>
        </MudStack>
    </MudAppBar>
</MudHidden>