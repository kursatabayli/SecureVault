{
  "Routes": [
    {
      "UpstreamPathTemplate": "/identity/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "IdentityService",
      "UpstreamHeaderTransform": {
        "X-Forwarded-For": "{RemoteIpAddress}"
      }
    },
    {
      "UpstreamPathTemplate": "/vault/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "VaultService",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "UpstreamPathTemplate": "/interaction/hubs/synchub",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/hubs/synchub",
      "DownstreamScheme": "ws",
      "ServiceName": "InteractionService",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "LoadBalancerOptions": {
        "Type": "CookieStickySessions",
        "Key": "SignalR_Affinity",
        "ExpiryInMs": 3600000
      }
    },
    {
      "UpstreamPathTemplate": "/interaction/hubs/qrlogin",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/hubs/qrlogin",
      "DownstreamScheme": "ws",
      "ServiceName": "InteractionService",
      "LoadBalancerOptions": {
        "Type": "CookieStickySessions",
        "Key": "SignalR_Affinity",
        "ExpiryInMs": 3600000
      }
    },
    {
      "UpstreamPathTemplate": "/interaction/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "InteractionService"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7202",
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    },
    "DownstreamScheme": "http",
    "LoadBalancerOptions": {
      "Type": "LeastConnection"
    },
    "RateLimitOptions": {
      "ClientIdHeader": "ClientId",
      "QuotaExceededMessage": "Rate limit exceeded.",
      "RateLimitCounterPrefix": "ocelot",
      "DisableRateLimitHeaders": false,
      "HttpStatusCode": 429,
      "ClientWhitelist": []
    }
  }
}
