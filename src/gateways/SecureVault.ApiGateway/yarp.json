{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**everything}",
          "Methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ],
        "Order": 2
      },
      "vault-route": {
        "ClusterId": "vault-cluster",
        "Match": {
          "Path": "/vault/{**everything}",
          "Methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/vault"
          }
        ],
        "AuthorizationPolicy": "default",
        "Order": 2
      },
      "interaction-route": {
        "ClusterId": "interaction-cluster",
        "Match": {
          "Path": "/interaction/{**everything}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/interaction"
          }
        ],
        "Order": 2
      }
    },
    "Clusters": {
      "identity-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api"
          }
        }
      },
      "vault-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "destination1": {
            "Address": "http://vault-api"
          }
        }
      },
      "interaction-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "destination1": {
            "Address": "http://interaction-api"
          }
        }
      }
    }
  }
}