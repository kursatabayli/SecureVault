{
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Consul": {
    "Host": "http://consul:8500",
    "ServiceName": "IdentityService",
    "ServiceAddress": "securevault-identity-api",
    "ServicePort": 8080
  },
  "ForwardedHeadersOptions": {
    "KnownNetworks": "172.22.0.0/16"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationName": "Identity.Api",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
